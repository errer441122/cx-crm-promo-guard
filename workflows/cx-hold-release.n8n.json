{
  "name": "CX-to-CRM Daily Hold Release (Cooldown State Machine)",
  "nodes": [
    {
      "id": "1",
      "name": "Schedule: Daily 07:30 CET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        260
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Klaviyo: Fetch Profiles with cx_promo_hold = true",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        260
      ],
      "parameters": {
        "url": "https://a.klaviyo.com/api/segments/GLOBAL_CX_HOLD_SEGMENT_ID/profiles/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "revision",
              "value": "2026-10-15"
            }
          ]
        }
      },
      "notes": "Retrieves all customers currently held out of promotional sends."
    },
    {
      "id": "3",
      "name": "Zendesk: Check Open Tickets for Email",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "position": [
        700,
        260
      ],
      "continueOnFail": true,
      "parameters": {
        "resource": "ticket",
        "operation": "getAll",
        "options": {
          "status": "open"
        }
      }
    },
    {
      "id": "4",
      "name": "Guard: Cooldown Expired & Zero Open Tickets?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "r1",
              "leftValue": "={{ $json.open_ticket_count || 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "r2",
              "leftValue": "={{ $json.cooldown_expired === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "notes": "Only releases hold when parcel is delivered past 7d cooldown (or 30d review cooldown) AND no open support ticket remains."
    },
    {
      "id": "5",
      "name": "Klaviyo: Release Hold (cx_promo_hold = false)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "https://a.klaviyo.com/api/profile-import/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "revision",
              "value": "2026-10-15"
            },
            {
              "name": "Content-Type",
              "value": "application/vnd.api+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: { type: 'profile', attributes: { email: $json.email, properties: { cx_promo_hold: false, cx_review_request_hold: false, cx_hold_reason: 'released_after_cooldown' } } } }) }}"
      }
    },
    {
      "id": "6",
      "name": "HubSpot: Release Hold (CX Promo Hold = No)",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        1240,
        340
      ],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "customPropertiesUi": {
            "customPropertiesValues": [
              {
                "property": "cx_promo_hold",
                "value": "false"
              },
              {
                "property": "cx_review_request_hold",
                "value": "false"
              },
              {
                "property": "cx_hold_reason",
                "value": "released_after_cooldown"
              }
            ]
          }
        },
        "authentication": "appToken"
      }
    }
  ],
  "connections": {
    "Schedule: Daily 07:30 CET": {
      "main": [
        [
          {
            "node": "Klaviyo: Fetch Profiles with cx_promo_hold = true",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Klaviyo: Fetch Profiles with cx_promo_hold = true": {
      "main": [
        [
          {
            "node": "Zendesk: Check Open Tickets for Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Zendesk: Check Open Tickets for Email": {
      "main": [
        [
          {
            "node": "Guard: Cooldown Expired & Zero Open Tickets?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guard: Cooldown Expired & Zero Open Tickets?": {
      "main": [
        [
          {
            "node": "Klaviyo: Release Hold (cx_promo_hold = false)",
            "type": "main",
            "index": 0
          },
          {
            "node": "HubSpot: Release Hold (CX Promo Hold = No)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}